# 个人 AI 心理伙伴环境变量配置
# 你可以在这里配置你的模型提供商信息 (如 OpenAI, DeepSeek, 阿里云百炼, 硅基流动等)

# ==================== 硅基流动 (推荐) ====================
# 硅基流动 API 密钥 - 从 https://cloud.siliconflow.cn 获取
SILICONFLOW_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# ==================== OpenAI ====================
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_BASE_URL="https://api.openai.com/v1"

# ==================== DeepSeek ====================
# 如使用 DeepSeek: https://api.deepseek.com/v1

# ==================== 阿里云百炼 ====================
# 如使用阿里云: https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 谷歌 AI ====================
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==================== 日志配置 ====================
# 日志级别: debug, info, warn, error
LOG_LEVEL="info"

# ==================== 模型配置 ====================
# 硅基流动支持的模型:Pro/MiniMaxAI/MiniMax-M2.5 Qwen/Qwen2.5-7B-Instruct, Qwen/Qwen2.5-14B-Instruct, meta-llama/Llama-3.1-8B-Instruct 等
AI_MODEL="Qwen/Qwen2.5-7B-Instruct"

# ==================== AI 开关 ====================
# true: 开启 AI 服务  false: 关闭 AI 服务
AI_ENABLED="true"