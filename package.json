{
  "name": "nuxtweb",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "set NODE_OPTIONS=--max-old-space-size=4096 && nuxt build",
    "dev": "nuxt dev",
    "dev:mock": "set NUXT_PUBLIC_USE_MOCK=true&& nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npx simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ext .ts,.js,.vue .",
    "lint:fix": "eslint --ext .ts,.js,.vue . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/vue": "^3.0.137",
    "@nuxt/ui": "^4.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@popperjs/core": "^2.11.8",
    "@sentry/vue": "^10.53.1",
    "@vueuse/core": "^14.2.0",
    "ai": "^6.0.137",
    "gsap": "^3.13.0",
    "nuxt": "^4.2.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@iconify-json/carbon": "^1.2.14",
    "@iconify-json/lucide": "^1.2.77",
    "@iconify/types": "^2.0.0",
    "@nuxt/eslint": "latest",
    "@nuxt/eslint-config": "latest",
    "@pinia/testing": "^1.0.3",
    "@typescript-eslint/parser": "^8.46.2",
    "@unocss/nuxt": "66.5.10-beta.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-vue": "^9.27.0",
    "happy-dom": "^15.11.7",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.9.0",
    "typescript": "^5.6.3",
    "unocss": "66.5.10-beta.1",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.2.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run lint"
  }
}
